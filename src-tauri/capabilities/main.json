{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-capability",
  "description": "Permisos principales de la aplicación",
  "windows": ["main", "doc-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-always-on-top",
    "dialog:allow-open",
    "shell:allow-open",
    "updater:default",
    "process:allow-restart",
    "core:webview:allow-print"
  ]
}
