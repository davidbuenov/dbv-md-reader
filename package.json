    "dompurify": "^3.4.13",
    "katex": "^0.18.4",
    "markdown-it": "^14.1.0",
    "markdown-it-footnote": "^4.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "mermaid": "^11.4.1",
    "pako": "^3.0.1",
    "prismjs": "^1.29.0"
  },
  "devDependencies": {
    "@choochmeque/tauri-windows-bundle": "^0.1.28",
    "@tauri-apps/cli": "^2.11.4"
