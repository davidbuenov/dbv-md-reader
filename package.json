{
  "name": "dbv-md-reader",
  "private": true,
  "version": "0.12.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "node scripts/build.mjs",
    "tauri": "tauri",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
